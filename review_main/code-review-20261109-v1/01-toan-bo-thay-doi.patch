+.showtime-accessible { margin-block: 16px; }
+.showtime-accessible summary { cursor: pointer; padding: 12px; font-weight: 600; }
+.showtime-accessible caption { text-align: left; padding: 12px; }
+@media (max-width: 640px) { .showtime-controls label { flex: 1 1 160px; } .showtime-controls input, .showtime-controls select { max-width: 100%; } }
